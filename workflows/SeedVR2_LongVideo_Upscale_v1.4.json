":{"name":"frame_rate"},"link":212}],"outputs":[{"name":"Filenames","type":"VHS_FILENAMES","links":[214]}],"widgets_values":{"frame_rate":30,"loop_count":0,"filename_prefix":"SeedVR2_stream_h264_10bit","format":"video/h264-mp4","pix_fmt":"yuv420p10le","crf":12,"save_metadata":true,"pingpong":false,"save_output":false,"videopreview":{"hidden":false,"paused":true,"params":{"format":"video/h264-mp4","frame_rate":30,"type":"temp"}},"trim_to_audio":false}},{"id":117,"type":"SeedVR2RemuxOriginalAudio","pos":[1410,-70],"size":[390,250],"flags":{},"order":7,"mode":0,"inputs":[{"name":"processed_video","type":"VHS_FILENAMES","link":214},{"name":"source_video","type":"STRING","widget":{"name":"source_video"},"link":215}],"outputs":[{"name":"final_video","type":"STRING","links":null}],"widgets_values":["","video/SeedVR2_LongVideo_Upscaled","mkv","copy",true]},{"id":118,"type":"MarkdownNote","pos":[-1280,390],"size":[1010,700],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[],"title":"SeedVR2 Long Video — Read Me","widgets_values":["# SeedVR2 Long Video — HD → 4K / OOM-Safe\n\n**Purpose:** upscale long videos with SeedVR2 without loading the whole source into VRAM.\n\n**Pipeline:** source video → automatic MetaBatch chunks → overlap context → SeedVR2 → H.264 10-bit stream → original-audio remux.\n\n### Main controls\n- **video**: source file under `ComfyUI/input/` (or use the upload button supplied by the custom node).\n- **chunk_seconds**: target amount of new source footage per pass. The helper chooses the nearest valid **4n+1** frame count. Reduce this first if you OOM.\n- **overlap_frames**: outer temporal context, default `8`. Boundary frames are regenerated with future context and written only once.\n- **scale_multiplier**: default `2x`. Example: 1080p → 2160p / 4K UHD.\n- **split_latent**: leave **OFF** when the outer chunk fits VRAM. Enable only as a secondary VRAM fallback.\n- **color correction**: `lab` by default for source-color fidelity.\n\n### Default output\nThe workflow encodes the streamed upscale as **H.264, yuv420p10le, CRF 12**. After the final MetaBatch, the remux node stream-copies that encoded video and restores the original audio, so there is **no second video encode**.\n\nDefault final container is **MKV** because it can stream-copy a wider range of source audio codecs. MP4 is optional; incompatible source audio falls back to AAC while the processed video remains stream-copied.\n\n### Optional ProRes\nIf you specifically need an editing/intermediate master, change Video Combine to `video/ProRes` and choose the desired profile. ProRes is not required for the normal HD/4K delivery workflow.\n\n### Memory behavior\nVideo duration does not accumulate in GPU memory: only the current chunk plus overlap is processed. Practical limits are render time and disk space rather than source duration.\n"],"color":"#222","bgcolor":"#000"}],"links":[[200,110,0,112,2,"STRING"],[201,110,4,111,0,"INT"],[202,111,0,112,0,"VHS_BatchManager"],[203,112,0,113,0,"IMAGE"],[204,111,0,113,1,"VHS_BatchManager"],[205,110,5,113,2,"INT"],[206,113,0,114,0,"IMAGE"],[207,114,0,115,0,"IMAGE"],[208,113,1,115,1,"INT"],[209,111,0,115,2,"VHS_BatchManager"],[210,110,5,115,3,"INT"],[211,115,0,116,0,"IMAGE"],[212,110,1,116,4,"FLOAT"],[213,111,0,116,2,"VHS_BatchManager"],[214,116,0,117,0,"VHS_FILENAMES"],[215,110,0,117,1,"STRING"]],"groups":[{"id":1,"title":"AUTOMATIC LONG VIDEO — HD → 4K / OOM-SAFE","bounding":[-1320,-410,3160,820],"color":"#3f789e","font_size":24,"flags":{}}],"definitions":{"subgraphs":[{"id":"1970dcb4-982a-4c01-a373-4d239a3041e4","version":1,"state":{"lastGroupId":1,"lastNodeId":105,"lastLinkId":126,"lastRerouteId":0},"name":"Upscale Frames (SeedVR2 3B Int8)","inputNode":{"id":-10,"bounding":[-580,10,211.892578125,328]},"outputNode":{"id":-20,"bounding":[3780,690,128,68]},"inputs":[{"id":"5e95a1d1-5ac1-4b13-931a-47efabf571b4","name":"images","type":"IMAGE","linkIds":[66],"pos":[-392.107421875,34]},{"id":"f03a6fda-1ed0-49b0-a120-15259bf